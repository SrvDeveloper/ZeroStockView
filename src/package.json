{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "format": "prettier --write resources/js resources/css README.md vite.config.js vitest.config.ts eslint.config.js tsconfig.json package.json",
        "format:check": "prettier --check resources/js resources/css README.md vite.config.js vitest.config.ts eslint.config.js tsconfig.json package.json",
        "lint": "eslint resources/js vite.config.js vitest.config.ts eslint.config.js",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "test": "vitest run --passWithNoTests",
        "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
        "build:prod": "vite build --mode prod"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "concurrently": "^9.0.1",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.10.0",
        "jsdom": "^30.0.1",
        "laravel-vite-plugin": "^3.1",
        "pinia": "^4.0.2",
        "pinia-plugin-persistedstate": "^4.7.1",
        "prettier": "^3.9.6",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.11",
        "vue": "^3.5.40",
        "vue-router": "^5.2.0",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "axios": "^1.19.0",
        "flowbite": "^4.0.2"
    }
}
